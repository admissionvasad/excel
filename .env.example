# Supabase (safe for the browser)
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. NEVER expose this to browser code or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# App
PUBLIC_APP_NAME="College ERP"
ORIGIN=http://localhost:5173
COOKIE_SECURE=false

# Notification providers (configurable, optional).
# Leave blank to disable a channel. Never hard-code credentials in source.
NOTIFICATION_EMAIL_PROVIDER=
NOTIFICATION_EMAIL_API_KEY=
NOTIFICATION_EMAIL_FROM=
NOTIFICATION_SMS_PROVIDER=
NOTIFICATION_SMS_API_KEY=
NOTIFICATION_SMS_SENDER=
NOTIFICATION_WHATSAPP_PROVIDER=
NOTIFICATION_WHATSAPP_API_KEY=

# Storage buckets
STORAGE_PRIVATE_BUCKET=erp-private
STORAGE_PUBLIC_BUCKET=erp-public
MAX_UPLOAD_MB=10
