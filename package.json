{
	"name": "college-erp",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"description": "Multi-college education ERP built with SvelteKit, TypeScript, and Supabase.",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"format": "prettier --write .",
		"test": "vitest run"
	},
	"dependencies": {
		"@supabase/ssr": "^0.12.7",
		"@supabase/supabase-js": "^2.116.0",
		"pdf-lib": "^1.17.1",
		"xlsx": "^0.18.5",
		"zod": "^3.25.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^22.20.3",
		"eslint": "^9.39.0",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^16.5.0",
		"prettier": "^3.9.7",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.0",
		"vite": "^8.0.16",
		"vitest": "^3.2.0"
	}
}
